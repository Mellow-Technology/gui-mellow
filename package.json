{
  "name": "gui-mellow",
  "version": "0.9.0",
  "description": "Shared React components for Next.js sites, styled with SCSS modules and themeable tokens.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.scss": "./src/styles/global.scss",
    "./styles/*": "./src/styles/*",
    "./theme": "./src/theme.ts",
    "./utils": "./src/utils/index.ts",
    "./*": "./src/components/*/index.ts"
  },
  "files": [
    "src",
    "LICENSE"
  ],
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "next dev showcase --port 3000",
    "build": "next build showcase",
    "start": "bunx serve showcase/out",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19",
    "sass": ">=1.80"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.106.1",
    "typescript": "~5.9.3"
  }
}
